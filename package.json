{
  "name": "hatch-ts-space-muse-code-space",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "typecheck": "bun x tsc --noEmit -p client/tsconfig.json && bun x tsc --noEmit -p server/tsconfig.json",
    "typecheck:dev": "bun x tsc --noEmit -p dev/tsconfig.json",
    "build": "bun run build:server && bun run build:client",
    "build:server": "cd server && bun build ./src/actions.ts --target=bun --outfile=./dist/actions.js",
    "build:client": "bun ./client/build.mjs",
    "dev": "bun --watch dev/server.ts",
    "dev:fake-pilot": "bun dev/fake-pilot.ts",
    "test:restart": "bun dev/restart-test.ts"
  },
  "dependencies": {
    "@hatch/space-sdk": "file:/opt/hatch/skills/spaces/ts-runtime/dist/space-sdk.tgz",
    "@tanstack/react-query": "5.100.10",
    "@types/bun": "1.4.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@wterm/dom": "0.5.4",
    "@wterm/react": "0.5.4",
    "bun-types": "1.4.2",
    "drizzle-orm": "0.45.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "2.15.3",
    "shiki": "3.19.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tailwindcss": "4.1.13",
    "tailwindcss-safe-area": "1.3.0",
    "typescript": "5.6.3"
  }
}
